{
  "name": "poker-planning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:server": "node server.js",
    "dev:full": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "start:server": "node server.js",
    "start:full": "npm run build && concurrently \"npm run start:server\" \"npm run start\"",
    "server": "node server.js",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio --port 5555",
    "db:seed": "npx tsx prisma/seeds-multi-tenant.ts",
    "db:reset": "npx prisma migrate reset && npm run db:seed",
    "db:push": "npx prisma db push",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "perf:analyze": "node scripts/analyze-bundle.js all",
    "perf:bundle": "node scripts/analyze-bundle.js bundle",
    "perf:deps": "node scripts/analyze-bundle.js deps",
    "perf:static": "node scripts/analyze-bundle.js static",
    "perf:report": "node scripts/analyze-bundle.js report",
    "perf:lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "express": "^4.21.2",
    "framer-motion": "^12.3.1",
    "i18next": "latest",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.474.0",
    "next": "15.1.6",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.5",
    "prisma": "^6.13.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.1",
    "react-i18next": "^15.4.0",
    "react-icons": "^5.4.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "eslint": "9.33.0",
    "eslint-config-next": "15.4.6",
    "jest": "^30.0.5",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.0",
    "typescript": "^5"
  }
}
