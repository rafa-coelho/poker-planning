// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 🏢 Organizações (Multi-tenancy)
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // Para URLs amigáveis
  plan        Plan     @default(FREE)
  settings    Json     @default("{}")
  logoUrl     String?
  domain      String?  // Para SSO futuro
  isActive    Boolean  @default(true)
  
  // External integration (futuro AuthService/Billing)
  externalId     String?      @unique
  externalSource String?      // "authservice", "billing", "sso"
  
  // Audit fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  users       User[]
  sessions    Session[]
  invites     Invite[]
  projects    Project[]
  teams       Team[]
  
  @@index([externalId])
  @@map("organizations")
}

// 👥 Usuários
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  passwordHash   String?      // Nullable para usuários externos
  avatar         String?
  locale         String       @default("pt")
  timezone       String       @default("America/Sao_Paulo")
  role           UserRole     @default(MEMBER)
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  
  // Password reset fields
  resetToken     String?      @unique
  resetTokenExpiresAt DateTime?
  
  // Multi-tenancy
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // External integration (futuro AuthService)
  externalId     String?      @unique
  externalSource String?      // "google", "microsoft", "authservice"
  
  // Audit fields
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  // Relations
  createdSessions Session[] @relation("SessionCreator")
  createdTeams   Team[] @relation("TeamCreator")
  createdProjects Project[] @relation("ProjectCreator")
  participants   SessionParticipant[]
  invitesSent    Invite[] @relation("InviteCreator")
  projectMembers ProjectMember[]
  teamMembers    TeamMember[]
  approvedPublicParticipants PublicParticipant[] @relation("PublicParticipantApprover")
  
  @@index([organizationId])
  @@index([email])
  @@index([externalId])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

// 🎮 Sessões de Planning
model Session {
  id             String        @id @default(cuid())
  name           String
  description    String?
  status         SessionStatus @default(ACTIVE)
  
  // Multi-tenancy
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Creator
  createdById    String
  createdBy      User          @relation("SessionCreator", fields: [createdById], references: [id])
  
  // Project association
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id])
  
  // Settings
  votingMode     VotingMode    @default(FIBONACCI)
  customCards    String[]      @default([]) // Para modo custom
  autoReveal     Boolean       @default(false)
  allowObservers Boolean       @default(true)
  timerDuration  Int?          // Em segundos
  
  // State
  currentTicketId String?
  currentTicket   Ticket?      @relation("CurrentTicket", fields: [currentTicketId], references: [id])
  isRevealed     Boolean       @default(false)
  
  // External integration (futuro integrações)
  externalId     String?      @unique
  externalSource String?      // "jira", "azure", "github"
  
  // Audit fields
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  endedAt        DateTime?
  
  // Public access settings
  publicAccessCode  String? @unique // código único para acesso público
  
  // Relations
  participants   SessionParticipant[]
  tickets        Ticket[]
  publicParticipants PublicParticipant[]
  
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
  @@index([projectId])
  @@index([publicAccessCode])
  @@index([externalId])
  @@map("sessions")
}

// 👤 Participantes de Sessão
model SessionParticipant {
  id        String   @id @default(cuid())
  
  // Relations
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Participant data
  role      ParticipantRole @default(VOTER)
  isActive  Boolean         @default(true)
  selectedCard String?      // Voto atual do participante
  
  // Audit fields
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  
  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("session_participants")
}

// 🌐 Participantes Públicos (sem conta)
model PublicParticipant {
  id            String   @id @default(cuid())
  sessionId     String
  name          String
  ipAddress     String?
  userAgent     String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  approvedBy    String?  // userId do aprovador
  approvedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  approver      User?    @relation("PublicParticipantApprover", fields: [approvedBy], references: [id])

  @@unique([sessionId, name])
  @@index([sessionId, status])
  @@index([expiresAt])
  @@map("public_participants")
}

// 📋 Projetos/Times
model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  color          String?  // Para UI
  isActive       Boolean  @default(true)
  
  // Multi-tenancy
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Creator
  createdById    String
  createdBy      User        @relation("ProjectCreator", fields: [createdById], references: [id])
  
  // External integration (futuro integrações)
  externalId     String?      @unique
  externalSource String?      // "jira", "azure", "github"
  
  // Audit fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  members        ProjectMember[]
  sessions       Session[]
  teams          Team[]
  
  @@index([organizationId])
  @@index([isActive])
  @@index([createdById])
  @@index([createdAt])
  @@index([externalId])
  @@map("projects")
}

// 👥 Times
model Team {
  id             String   @id @default(cuid())
  name           String
  description    String?
  color          String?  // Para UI
  isActive       Boolean  @default(true)
  
  // Multi-tenancy
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Creator
  createdById    String
  createdBy      User        @relation("TeamCreator", fields: [createdById], references: [id])
  
  // External integration (futuro integrações)
  externalId     String?      @unique
  externalSource String?      // "jira", "azure", "github"
  
  // Audit fields
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  members        TeamMember[]
  projects       Project[]    // Times podem estar associados a projetos
  
  @@index([organizationId])
  @@index([isActive])
  @@index([createdById])
  @@index([createdAt])
  @@index([externalId])
  @@map("teams")
}

// 👥 Membros de Time
model TeamMember {
  id        String      @id @default(cuid())
  
  // Relations
  teamId    String
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Member data
  role      TeamRole    @default(MEMBER)
  
  // Audit fields
  joinedAt  DateTime    @default(now())
  
  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

// 👥 Membros de Projeto
model ProjectMember {
  id        String      @id @default(cuid())
  
  // Relations
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Member data
  role      ProjectRole @default(MEMBER)
  
  // Audit fields
  joinedAt  DateTime    @default(now())
  
  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// 🎫 Tickets/Histórias
model Ticket {
  id          String       @id @default(cuid())
  title       String
  description String?
  identifier  String?      // Ex: "PROJ-123"
  priority    Priority     @default(MEDIUM)
  status      TicketStatus @default(PENDING)
  
  // Relations
  sessionId   String
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  // Estimation
  finalEstimate    String?     // Valor final escolhido pelo dono da sessão
  averageVote      Float?      // Média dos votos calculada
  consensusReached Boolean     @default(false)
  votingStartedAt  DateTime?
  votingEndedAt    DateTime?
  
  // External integration (futuro integrações)
  externalId     String?      @unique
  externalSource String?      // "jira", "azure", "github"
  
  // Audit fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  sessions    Session[] @relation("CurrentTicket")
  
  @@index([sessionId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([externalId])
  @@map("tickets")
}

// 📧 Convites
model Invite {
  id             String      @id @default(cuid())
  email          String
  role           UserRole    @default(MEMBER)
  status         InviteStatus @default(PENDING)
  token          String      @unique
  expiresAt      DateTime
  
  // Multi-tenancy
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Creator
  createdById    String
  createdBy      User        @relation("InviteCreator", fields: [createdById], references: [id])
  
  // Metadata
  metadata       Json        @default("{}") // Para dados extras
  
  // Audit fields
  createdAt      DateTime    @default(now())
  acceptedAt     DateTime?
  
  @@index([organizationId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("invites")
}

// 📊 Enums
enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MEMBER
  VIEWER
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum VotingMode {
  FIBONACCI
  TSHIRT
  LINEAR
  CUSTOM
}

enum ParticipantRole {
  VOTER
  OBSERVER
  MODERATOR
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum TeamRole {
  ADMIN
  MEMBER
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  PENDING
  VOTING
  ESTIMATED
  COMPLETED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// 🎯 Modo Aberto - Sessões Temporárias
model OpenSession {
  id             String        @id @default(uuid())
  name           String
  description    String?
  votingMode     VotingMode    @default(FIBONACCI)
  autoReveal     Boolean       @default(false)
  allowObservers Boolean       @default(true)
  isRevealed     Boolean       @default(false)
  
  // Criador da sessão
  creatorName    String
  creatorIp      String?
  creatorUserAgent String?
  
  // Ticket atual sendo votado
  currentTicketId String?
  currentTicket   OpenTicket?  @relation("CurrentTicket", fields: [currentTicketId], references: [id])
  
  // Expiração automática
  expiresAt      DateTime      @default(dbgenerated("NOW() + INTERVAL '24 hours'"))
  
  // Audit fields
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  // Relations
  participants   OpenSessionParticipant[]
  tickets        OpenTicket[]
  
  @@index([expiresAt])
  @@index([createdAt])
  @@map("open_sessions")
}

// 👥 Participantes do Modo Aberto
model OpenSessionParticipant {
  id             String        @id @default(uuid())
  sessionId      String
  name           String
  selectedCard   String?
  isActive       Boolean       @default(true)
  
  // Informações de conexão
  ipAddress      String?
  userAgent      String?
  
  // Audit fields
  joinedAt       DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  
  // Relations
  session        OpenSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  votes          OpenVote[]
  
  @@index([sessionId])
  @@index([isActive])
  @@map("open_session_participants")
}

// 🎫 Tickets do Modo Aberto
model OpenTicket {
  id             String        @id @default(uuid())
  sessionId      String
  title          String
  description    String?
  finalEstimate  String?
  averageVote    String?
  
  // Audit fields
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  // Relations
  session        OpenSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  votes          OpenVote[]
  currentSession OpenSession[] @relation("CurrentTicket")
  
  @@index([sessionId])
  @@index([createdAt])
  @@map("open_tickets")
}

// 🗳️ Votos do Modo Aberto
model OpenVote {
  id             String        @id @default(uuid())
  ticketId       String
  participantId  String
  card           String
  
  // Audit fields
  createdAt      DateTime      @default(now())
  
  // Relations
  ticket         OpenTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  participant    OpenSessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  @@unique([ticketId, participantId])
  @@index([ticketId])
  @@index([participantId])
  @@map("open_votes")
}
